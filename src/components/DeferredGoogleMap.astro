---
import type { MapContent } from '../data/types';

interface Props {
  content: MapContent;
  embedUrl: string;
}

const { content, embedUrl } = Astro.props;
---

<div
  class="relative isolate min-h-64 overflow-hidden rounded-[1.5rem] border border-[var(--color-border)] bg-[linear-gradient(135deg,rgba(4,92,180,0.08),rgba(255,119,0,0.08))] sm:aspect-[16/8] sm:min-h-0"
  data-deferred-google-map
  data-map-category="googleMaps"
>
  <iframe
    data-map-embed
    data-src={embedUrl}
    title={content.iframeTitle}
    class="absolute inset-0 h-full w-full border-0"
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
    hidden
  ></iframe>

  <div data-map-placeholder class="absolute inset-0 flex items-center justify-center p-6 text-center">
    <div class="max-w-md rounded-[1.25rem] border border-white/70 bg-white/85 p-6 shadow-[0_18px_40px_rgba(2,6,23,0.08)] backdrop-blur-sm sm:p-8">
      <p class="text-[0.72rem] uppercase tracking-[0.22em] text-[var(--color-text-soft)]">{content.mapConsentTitle}</p>
      <p class="mt-3 text-sm leading-6 text-[var(--color-text-muted)]">{content.mapConsentText}</p>
      <p class="mt-2 text-xs leading-5 text-[var(--color-text-soft)]">{content.privacyNotice}</p>
      <button
        type="button"
        class="mt-5 inline-flex min-h-11 items-center justify-center rounded-full border border-[var(--color-border-strong)] px-5 py-3 text-sm font-medium text-[var(--color-text)] transition hover:border-[var(--color-secondary)] hover:bg-[rgba(4,92,180,0.06)]"
        data-consent-google-maps
      >
        {content.loadMapLabel}
      </button>
    </div>
  </div>
</div>
