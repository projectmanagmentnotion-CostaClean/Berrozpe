---
interface Props {
  summary: string[];
  linkLabel: string;
  href: string;
}

const {
  summary,
  linkLabel,
  href,
} = Astro.props;
---

<div class="rounded-[1.5rem] border border-[var(--color-border)] bg-white/[0.6] p-4 text-sm leading-6 text-[var(--color-text-muted)]">
  {summary.map((line) => <p>{line}</p>)}
  <p class="mt-2">
    <a class="font-medium text-[var(--color-secondary)] underline underline-offset-4" href={href}>
      {linkLabel}
    </a>
  </p>
</div>
