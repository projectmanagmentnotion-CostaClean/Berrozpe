---
import type { ReviewsContent, SharedReviews } from '../data/types';

interface Props {
  reviews: SharedReviews['reviews'];
  content: ReviewsContent;
}

const { reviews, content } = Astro.props;
const featuredReviews = reviews.slice(0, 5);
---

{featuredReviews.length > 0 ? (
  <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-review-grid>
    {featuredReviews.map((review) => (
      <article class="flex h-full flex-col rounded-[1.5rem] border border-[var(--color-border)] bg-white/70 p-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <p class="text-sm font-semibold text-[var(--color-text)]">{review.author}</p>
          <p
            class="shrink-0 text-base tracking-[0.12em] text-[var(--color-accent)]"
            role="img"
            aria-label={`${review.ratingValue} / 5`}
          >
            {'★'.repeat(Math.max(0, Math.min(5, Math.round(review.ratingValue))))}{'☆'.repeat(5 - Math.max(0, Math.min(5, Math.round(review.ratingValue))))}
          </p>
        </div>
        <p class="mt-4 flex-1 text-sm leading-7 text-[var(--color-text-muted)]">{review.reviewBody}</p>
        <div class="mt-5 flex items-center justify-between gap-3 border-t border-[var(--color-border)] pt-4 text-xs text-[var(--color-text-soft)]">
          <a href={review.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[var(--color-secondary)]">
            {content.reviewSourceLabel}
          </a>
          {review.datePublished && <time datetime={review.datePublished}>{review.datePublished}</time>}
        </div>
      </article>
    ))}
  </div>
) : (
  <div class="mt-6 rounded-[1.5rem] border border-dashed border-[var(--color-border-strong)] bg-white/55 p-6 sm:p-8" data-review-grid-empty>
    <p class="text-sm leading-7 text-[var(--color-text-muted)]">{content.noReviewsFallback}</p>
  </div>
)}
